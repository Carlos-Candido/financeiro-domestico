<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Finance.Avalonia.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#F4F6F4" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InkBrush" Color="#202D31" />
        <SolidColorBrush x:Key="MutedBrush" Color="#647176" />
        <SolidColorBrush x:Key="AccentBrush" Color="#236B5C" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1B584C" />
        <SolidColorBrush x:Key="LineBrush" Color="#E2E8E4" />
        <SolidColorBrush x:Key="HeroBrush" Color="#173C36" />
        <SolidColorBrush x:Key="PositiveBrush" Color="#23734D" />
        <SolidColorBrush x:Key="NegativeBrush" Color="#A5423E" />
        <SolidColorBrush x:Key="WarningBrush" Color="#8A6417" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#F0F4F1" />
        <SolidColorBrush x:Key="NavActiveBrush" Color="#E9F1ED" />
        <SolidColorBrush x:Key="HoverBorderBrush" Color="#B8C9C1" />
        <SolidColorBrush x:Key="PositiveSurfaceBrush" Color="#EAF1ED" />
        <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#F7F1DE" />
        <SolidColorBrush x:Key="NegativeSurfaceBrush" Color="#F8ECEB" />
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HeroBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource HeroBrush}" />
        </Style>
        <Style Selector="Button.primary:disabled">
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinHeight" Value="46" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NavActiveBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NavActiveBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.nav.active:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NavActiveBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.nav:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="Button.nav:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Button.quiet:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.quiet:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
        </Style>
        <Style Selector="Button.quiet:disabled">
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="BorderBrush" Value="{DynamicResource NegativeBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NegativeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NegativeBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NegativeSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NegativeBrush}" />
        </Style>
        <Style Selector="Button.danger:disabled">
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="Button.danger:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="Button:focus /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.entryButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.entryButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.entryButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.entryButton:focus /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="11,9" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="8,7" />
        </Style>
        <Style Selector="DatePicker">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="27" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.cardSelected">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="15" />
        </Style>
        <Style Selector="Border.summaryCard">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style Selector="Border.statusPill">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="Border.statusPill TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="Border.statusPill.positive">
            <Setter Property="Background" Value="{DynamicResource PositiveSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PositiveSurfaceBrush}" />
        </Style>
        <Style Selector="Border.statusPill.positive TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
        </Style>
        <Style Selector="Border.statusPill.warning">
            <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningSurfaceBrush}" />
        </Style>
        <Style Selector="Border.statusPill.warning TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="Border.statusPill.neutral">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>
        <Style Selector="Border.statusPill.neutral TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}" />
        </Style>
        <Style Selector="Border.cardSelected:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
    </Application.Styles>
</Application>
