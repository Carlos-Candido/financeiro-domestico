<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Finance.Avalonia"
        x:Class="Finance.Avalonia.MainWindow"
        Title="Finance"
        Width="1240" Height="860"
        MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="24,0" Spacing="12" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="F" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="Finance" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="CONTROLE FAMILIAR" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,24">
                <StackPanel DockPanel.Dock="Top" Spacing="5">
                    <TextBlock Text="MENU" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,9" />
                    <Button Classes="nav" Content="⌂   Visão geral" Click="OnShowDashboard" />
                    <Button Classes="nav" Content="▤   Histórico" Click="OnShowHistory" />
                    <Button Classes="nav" Content="＄   Salários da família" Click="OnShowFamilySalaries" />
                    <Button Classes="nav" Content="↻   Recorrências" Click="OnShowRecurrences" />
                    <Button Classes="nav" Content="⚙   Configurações" Click="OnShowSettings" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource CanvasBrush}" CornerRadius="10" Padding="13" Margin="0,24,0,0">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Seus dados ficam" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="salvos neste dispositivo." FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="30,24,30,30">
            <views:MonthView x:Name="DashboardPanel" IsVisible="True" />
            <views:HistoryView x:Name="HistoryPanel" IsVisible="False" />
            <views:RecurrencesView x:Name="RecurrencesPanel" IsVisible="False" />
            <views:FamilySalariesView x:Name="FamilySalariesPanel" IsVisible="False" />
            <views:SettingsView x:Name="SettingsPanel" IsVisible="False" />
        </Grid>
    </Grid>
</Window>
