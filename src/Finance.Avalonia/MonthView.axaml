<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Finance.Avalonia.MonthView">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="Visão geral" Classes="heading" />
                    <TextBlock Text="Acompanhe as movimentações da família" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="PreviousButton" Content="‹" AutomationProperties.Name="Mês anterior" Click="OnPreviousMonth" Width="44" Padding="0" FontSize="24" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <TextBlock x:Name="MonthHeading" TextAlignment="Center" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="NextButton" Content="›" AutomationProperties.Name="Próximo mês" Click="OnNextMonth" Width="44" Padding="0" FontSize="24" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource HeroBrush}" CornerRadius="16" Padding="22,15">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="SALDO DISPONÍVEL" FontSize="12" FontWeight="SemiBold" Foreground="#C5D7D1" />
                        <TextBlock x:Name="BalanceText" FontSize="34" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                        <TextBlock Text="Considera somente lançamentos confirmados" FontSize="14" Foreground="#D8E3DF" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="48" Height="48" CornerRadius="24" Background="#315A51" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="R$" FontSize="18" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <WrapPanel>
                <Button x:Name="AddIncomeButton" Content="＋   Adicionar dinheiro" Classes="primary" Click="OnAddIncome" Margin="0,0,12,0" />
                <Button x:Name="AddExpenseButton" Content="−   Registrar gasto" Click="OnAddExpense" />
            </WrapPanel>

            <Grid ColumnDefinitions="*,12,*">
                <Border Classes="summaryCard">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Receitas confirmadas" Foreground="{DynamicResource MutedBrush}" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock x:Name="IncomeTotalText" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource PositiveBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="summaryCard">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Despesas confirmadas" Foreground="{DynamicResource MutedBrush}" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock x:Name="ExpenseTotalText" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource NegativeBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="card" Padding="17,14">
                <StackPanel Spacing="5">
                    <TextBlock x:Name="PendingText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ForecastText" Foreground="{DynamicResource MutedBrush}" FontSize="14" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Text="Lançamentos recentes" Classes="sectionTitle" />
                    <TextBlock Text="Movimentações deste mês" Foreground="{DynamicResource MutedBrush}" FontSize="14" />
                </StackPanel>
                <Button Grid.Column="1" Classes="quiet" Content="Ver histórico  →" Click="OnOpenHistory" VerticalAlignment="Center" />
            </Grid>
            <StackPanel x:Name="MonthList" Spacing="9" HorizontalAlignment="Stretch" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
